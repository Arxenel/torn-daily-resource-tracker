  })();
  // ===========================================================================
  // PAGE READERS  (only the page the player is viewing; never navigates)
  // ===========================================================================
  const Pages = (() => {
    let travel = null;
    let observer = null;
    let lastHref = '';
    const subs = [];
    let debounce = null;
    function isTravelPage() {
      const p = location.pathname; const q = location.search || '';
      return p === '/travelagency.php' || (p === '/page.php' && /(^|[?&])sid=travel(&|$)/.test(q.replace(/^\?/, '?')));
    }
    function readTravel() {
      const root = document.getElementById('travel-root');
      if (!root) return { available: false, reason: 'The Travel page data is not loaded yet.' };
      let model = null;
      try { model = JSON.parse(root.getAttribute('data-model') || 'null'); } catch (e) { model = null; }
      const q = (sel) => root.querySelector(sel) || document.querySelector(sel);
      const typeEl = q('input[name="travelType"][aria-checked="true"]') || q('input[name="travelType"]:checked');
      const destEl = q('input[name="destination"][aria-checked="true"]') || q('input[name="destination"]:checked');
      const parsed = Parse.travelModel(model, typeEl && typeEl.value, destEl && destEl.value);
      if (!parsed) return { available: false, reason: 'This version of the Travel page does not expose flight data the tracker can read.' };
      if (!parsed.selected) {
