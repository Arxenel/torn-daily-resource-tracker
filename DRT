      }
      return crow(ICON[key], key, '<span class="trt-cg">' + (sec.state === 'loading' ? '\u2026' : '\u2013') + '</span>', sec.state === 'loading' ? '' : '?', label + ': ' + stateText(sec, key), null);
    }
    function cLog(key, sec, unit, label) {
