    function signature(t) { return t ? JSON.stringify([t.available, t.reason, t.type, t.selected && t.selected.id, t.ocText, (t.dests || []).map((d) => [d.flightSec, d.tornFlag])]) : 'none'; }
    function notify() {
      const sig = signature(travel);
      if (sig === lastSig) return; // nothing the UI shows has changed
      lastSig = sig;
