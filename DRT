        return { state: 'ok', target: (cd.at || snap.serverMs || now) + cd[k] * 1000, stale: coreStale };
      };
      vm.cooldowns = { drug: cdOne('drug'), booster: cdOne('booster'), medical: cdOne('medical') };

      // --- Refills (authoritative state from Torn; never assumed at New Day)
      const pairs = { energy: 'refills', nerve: 'nerverefills', token: 'tokenrefills' };
      vm.refills = {};
      for (const k of Object.keys(pairs)) {
        const r = snap.refills;
