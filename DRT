    }
    function travelVerdict(returnAt, readyAt, bufferMs, now) {
      if (!U.isNum(readyAt)) return null;
      if (returnAt > readyAt) return 'CONFLICT';
      if (readyAt - returnAt < bufferMs) return 'CAUTION';
      return 'SAFE';
    }

    function compute() {
      const S = Settings.get();
      const now = Time.now();
      const day = Data.day;
      const snap = Data.snap || {};
      const meta = Data.meta || {};
      const flags = meta.flags || {};
      const ks = keyState();
      const access = ks.state === 'ok' ? ks.access : null;
      const dayStart = day ? day.start : Time.dayStart(now);
      const coreEvery = S.refresh.coreSec * 1000;
      const coreAge = snap.coreAt ? now - snap.coreAt : null;
      const coreStale = coreAge === null || coreAge > Math.max(3 * coreEvery, 180000);
      const coreToday = !!snap.coreAt && snap.coreAt >= dayStart;
      const logsUsable = !!(access && access.log && S.useLogs && !meta.logAccessDenied);
      const vm = { S, now, key: ks, access, dayKey: day ? day.date : Time.dateKey(now), coreAge, coreStale, coreToday, logsUsable };

      // --- Energy / Nerve (activity log)
      const logSection = (kind, goal, barKey) => {
