      }
      if (ta) ta.value = '';
      Sync.broadcast('settings');
      setNotice('data', 'good', 'Imported settings and ' + days + ' new day' + (days === 1 ? '' : 's') + ' of history.');
    }
    function act(name) {
      switch (name) {
        case 'expand': view = 'main'; setState('expanded'); break;
        case 'collapse': view = 'main'; exportText = ''; setState('collapsed'); break;
        case 'hide': view = 'main'; setState('hidden'); break;
        case 'settings': view = 'settings'; notice = null; if (Settings.get().ui.state !== 'expanded') setState('expanded'); else requestRender('ui'); break;
        case 'back': setView('main'); break;
        case 'refresh':
          if (Date.now() - manualAt < 10000) return;
          manualAt = Date.now();
          if (Sync.isLeader()) Service.forceRefresh(0); else Sync.broadcast('refresh');
          requestRender('ui'); setTimeout(() => requestRender('ui'), 10100);
          break;
        case 'save-key': saveKey(); break;
        case 'remove-key': removeKey(); break;
        case 'retry-key': retryKey(); break;
        case 'export': exportText = buildExport(); notice = null; requestRender('ui'); break;
        case 'copy-export': copyExport(); break;
        case 'download-export': downloadExport(); break;
        case 'import': doImport(); break;
        case 'reset-history':
          if (!arm('reset-history')) return;
          Data.resetHistory();
          Data.ensureDay(Time.currentDateKey(), Sync.isLeader() && Time.trusted());
          Sync.broadcast('reset');
          if (Sync.isLeader()) Service.forceRefresh(0);
          setNotice('data', 'good', "History cleared. Today's numbers are being rebuilt from Torn.");
          break;
        case 'reset-settings':
          if (!arm('reset-settings')) return;
          Settings.reset(); Sync.broadcast('settings');
          setNotice('data', 'good', 'Settings reset to defaults.');
          break;
        case 'reset-position': Settings.update((s) => { s.ui.corner = 'top-right'; s.ui.pos = null; }); Sync.broadcast('settings'); break;
        default: break;
      }
    }
    function setPath(obj, path, val) {
      const parts = path.split('.'); let o = obj;
      for (let i = 0; i < parts.length - 1; i++) o = o[parts[i]];
      o[parts[parts.length - 1]] = val;
    }

    // ------------------------------------------------------------ events
    function onClick(e) {
      if (Date.now() < suppressClickUntil) { e.preventDefault(); e.stopPropagation(); return; }
      const t = e.target;
      const a = t.closest ? t.closest('[data-act]') : null;
      if (a && root.contains(a)) { e.preventDefault(); if (!a.disabled) act(a.getAttribute('data-act')); return; }
      if (t.closest && t.closest('.trt-tile')) { e.preventDefault(); act('expand'); }
    }
    function onChange(e) {
      const el = e.target;
      if (!el || !root.contains(el)) return;
      if (el.hasAttribute('data-goaloff')) {
        const k = el.getAttribute('data-goaloff');
        Settings.update((s) => { s.goals[k] = el.checked ? null : DEFAULT_SETTINGS.goals[k]; });
        Sync.broadcast('settings');
        return;
      }
      const path = el.getAttribute('data-set');
      if (!path) return;
      let val;
      if (el.type === 'checkbox') val = el.checked;
      else if (el.type === 'number') val = el.value === '' ? null : Number(el.value);
      else val = el.value;
      if (path === 'ui.scale' || path === 'refresh.coreSec') val = Number(val);
      Settings.update((s) => { setPath(s, path, val); if (path === 'ui.corner' && val !== 'custom') s.ui.pos = null; });
      Sync.broadcast('settings');
    }
    function isEditable(el) { return !!el && (el.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)); }
    function onKeyDown(e) {
      const t = e.target;
      if (t && t.classList && t.classList.contains('trt-tile') && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); act('expand'); return; }
      if (e.key === 'Escape' && Settings.get().ui.state === 'expanded' && !isEditable(t)) { e.preventDefault(); act('collapse'); }
    }
    function onGlobalKey(e) {
      if (!(e.altKey && e.shiftKey && !e.ctrlKey && !e.metaKey && e.code === 'KeyD')) return;
      if (isEditable(e.target)) return;
      e.preventDefault();
      const s = Settings.get().ui.state;
      setState(s === 'hidden' ? 'collapsed' : (canHide() ? 'hidden' : 'collapsed'));
    }
    function onPointerDown(e) {
      if (e.button !== undefined && e.button !== 0) return;
      const handle = e.target.closest ? e.target.closest('[data-drag]') : null;
      if (!handle || !root.contains(handle)) return;
      if (e.target.closest('button, a, input, select, textarea, label')) return;
      const r = root.getBoundingClientRect();
      drag = { id: e.pointerId, sx: e.clientX, sy: e.clientY, left: r.left, top: r.top, w: r.width, h: r.height, moved: false };
      try { if (handle.setPointerCapture && e.pointerId !== undefined) handle.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
      window.addEventListener('pointermove', onPointerMove, { passive: false });
      window.addEventListener('pointerup', onPointerUp);
      window.addEventListener('pointercancel', onPointerUp);
    }
    function onPointerMove(e) {
      if (!drag || (drag.id !== undefined && e.pointerId !== undefined && e.pointerId !== drag.id)) return;
      const dx = e.clientX - drag.sx; const dy = e.clientY - drag.sy;
      if (!drag.moved && Math.abs(dx) + Math.abs(dy) < 6) return;
      drag.moved = true;
      root.classList.add('trt-dragging');
      const vw = window.innerWidth || 1024; const vh = window.innerHeight || 768;
      const st = root.style;
      st.right = 'auto'; st.bottom = 'auto';
      st.left = U.clamp(drag.left + dx, 4, Math.max(4, vw - drag.w - 4)) + 'px';
      st.top = U.clamp(drag.top + dy, 4, Math.max(4, vh - Math.min(drag.h, vh - 8) - 4)) + 'px';
      if (e.cancelable) e.preventDefault();
    }
    function onPointerUp() {
      window.removeEventListener('pointermove', onPointerMove);
      window.removeEventListener('pointerup', onPointerUp);
      window.removeEventListener('pointercancel', onPointerUp);
      if (!drag) return;
      const d = drag; drag = null;
      root.classList.remove('trt-dragging');
      if (!d.moved) return;
      suppressClickUntil = Date.now() + 350;
      const r = root.getBoundingClientRect();
      const vw = window.innerWidth || 1024; const vh = window.innerHeight || 768;
      const h = (r.left + r.width / 2) > vw / 2 ? 'right' : 'left';
      const v = (r.top + r.height / 2) > vh / 2 ? 'bottom' : 'top';
      const x = Math.max(4, Math.round(h === 'left' ? r.left : vw - r.right));
      const y = Math.max(4, Math.round(v === 'top' ? r.top : vh - r.bottom));
      Settings.update((s) => { s.ui.corner = 'custom'; s.ui.pos = { h, v, x, y }; });
      Sync.broadcast('settings');
    }
    let resizeTimer = null;
    function onResize() { clearTimeout(resizeTimer); resizeTimer = setTimeout(applyPosition, 120); }

    function mount() {
      if (document.getElementById('trt-root')) return false;
      const style = document.createElement('style');
      style.id = 'trt-style';
      style.textContent = CSS;
      (document.head || document.documentElement).appendChild(style);
      root = document.createElement('div');
      root.id = 'trt-root';
      document.body.appendChild(root);
      root.addEventListener('click', onClick);
      root.addEventListener('change', onChange);
      root.addEventListener('keydown', onKeyDown);
      root.addEventListener('pointerdown', onPointerDown);
      window.addEventListener('resize', onResize);
      document.addEventListener('keydown', onGlobalKey);
      render(new Set(['state']));
      return true;
    }
    function registerMenu() {
      if (!hasMenu) return;
      try {
        GM_registerMenuCommand('Show tracker', () => { if (Settings.get().ui.state === 'hidden') setState('collapsed'); });
        GM_registerMenuCommand('Hide tracker', () => setState('hidden'));
        GM_registerMenuCommand('Expand tracker', () => { view = 'main'; setState('expanded'); });
        GM_registerMenuCommand('Open settings', () => { view = 'settings'; setState('expanded'); });
        GM_registerMenuCommand('Reset position', () => { Settings.update((s) => { s.ui.corner = 'top-right'; s.ui.pos = null; }); Sync.broadcast('settings'); });
      } catch (e) { /* menu not supported */ }
    }
    return {
      mount, render, requestRender, tick, registerMenu, canHide, setState, setView, applyPosition,
      get view() { return view; }, get root() { return root; },
    };
  })();
  // ===========================================================================
  // BOOT
  // ===========================================================================
  let bootStartedAt = 0;

  // A visible tab takes over API duty if the leader tab stopped updating.
  function watchdog() {
    if (Sync.isLeader() || document.hidden || !Api.getKey() || Api.isHalted()) return;
    Data.reload();
    const last = Data.meta.lastCoreAt || 0;
    const limit = 3 * Settings.get().refresh.coreSec * 1000 + 90000;
    if ((last && Date.now() - last > limit) || (!last && Date.now() - bootStartedAt > 120000)) Sync.takeOver();
  }

  // Switches the daily ledger exactly when the TCT date changes. Game-state
  // values (refills, casino, cooldowns) are then refreshed from Torn instead
  // of being assumed.
  function checkRollover() {
    const k = Time.currentDateKey();
    const leader = Sync.isLeader() && Time.trusted();
    if (Data.day && Data.day.date === k && !(Data.ephemeral && leader)) return false;
    if (!Data.ensureDay(k, leader)) return false;
    if (leader) {
      Sync.broadcast('day');
      Service.forceRefresh(3000);
      Service.forceRefresh(35000); // first counter read that is certainly after New Day (Torn may cache up to 30s)
    }
    UI.requestRender('data');
    return true;
  }

  function boot() {
    if (!document.body) { setTimeout(boot, 50); return; }
    if (document.getElementById('trt-root')) return;
    bootStartedAt = Date.now();
    Api.restoreHalt();
    Time.restore(Data.meta);
    Data.ensureDay(Time.currentDateKey(), false);
    // A hidden tracker must stay reachable where no userscript menu exists.
    if (Settings.get().ui.state === 'hidden' && !UI.canHide()) Settings.update((s) => { s.ui.state = 'collapsed'; }, { silent: true });
    if (!UI.mount()) return;

    Settings.onChange(() => UI.requestRender('settings'));
    Theme.watch(() => UI.requestRender('theme'));
    Api.onChange(() => UI.requestRender('data'));
    Service.onUpdate(() => UI.requestRender('data'));
    Pages.onChange(() => UI.requestRender('data'));
    Time.onJump(() => { if (Sync.isLeader()) Service.forceRefresh(0); });

    Sync.onLeader((isLeader) => {
      if (isLeader) {
        Data.reload();
        Data.ensureDay(Time.currentDateKey(), Time.trusted());
        Service.start();
        Service.forceRefresh(0);
      }
      UI.requestRender('data');
    });
    Sync.onMessage((msg) => {
      if (msg.type === 'settings') Settings.reload();
      if (msg.type === 'key') Api.restoreHalt();
      if (msg.type === 'reset') { Data.resetHistory(); Data.ensureDay(Time.currentDateKey(), Sync.isLeader() && Time.trusted()); }
      Data.reload();
      if (Sync.isLeader() && (msg.type === 'refresh' || msg.type === 'key' || msg.type === 'reset')) Service.forceRefresh(0);
      UI.requestRender(msg.type === 'settings' ? 'settings' : 'data');
    });

    UI.registerMenu();
    Sync.start();

    let n = 0;
    setInterval(() => {
      n++;
      Time.checkJump();
      Pages.check();
      checkRollover();
      if (!document.hidden) UI.tick();
      if (n % 10 === 0 && !document.hidden) UI.requestRender('data');
      if (n % 30 === 0) watchdog();
    }, 1000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) { Time.checkJump(); checkRollover(); UI.requestRender('data'); }
    });
    Pages.check();
  }

  boot();
})();
