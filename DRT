/*
 * TORN Daily Resource Tracker
 * One small movable window that remembers your Torn day for you.
 *
 * - Read-only. It never clicks, buys, travels, attacks, refills, plays the
 *   Casino or uses items. It only displays information.
 * - Network: talks only to Torn's official API (https://api.torn.com/v2).
 * - Page data: reads the Travel page model only while you are viewing it.
 * - Daily reset follows Torn City Time (UTC), never your local clock.
 * - Needs a Full Access API key for every feature: energy and nerve usage
 *   come only from your Torn activity log, which Torn shares only with
 *   Full Access keys. Smaller keys still work, without those two.
 * - Your API key and history stay in this browser. No analytics.
 *
 * MIT License. Copyright (c) 2026 Arxenel [4390395]
 *
 * Recreating or modifying this script? Please don't forget to credit the
 * original author, Arxenel [4390395]:
 * https://www.torn.com/profiles.php?XID=4390395
 * The MIT license also requires this copyright notice to stay in every
 * copy or modified version.
 */
(function () {
  'use strict';

  if (window.top !== window.self) return;
  if (document.getElementById('trt-root')) return;

  // ===========================================================================
  // CONSTANTS
  // ===========================================================================
  const TRT_VERSION = '1.0.0';
  const API_BASE = 'https://api.torn.com/v2';
  const API_COMMENT = 'TRTracker'; // Torn shows max 10 chars of the comment in your API log
  const SUPPORT = { name: 'Arxenel', id: 4390395, url: 'https://www.torn.com/profiles.php?XID=4390395' };
  const TORN_API_SETTINGS_URL = 'https://www.torn.com/preferences.php#tab=api';
  const DAY_MS = 86400000;
  const CITY_DAILY_ALLOWANCE = 100; // Torn wiki "City": 100 items per day from East Side shops
  const CASINO_DAILY_BASE = 75;     // Torn wiki "Casino": 75 tokens received at New Day
  const COUNTER_STATS = ['xantaken', 'cityitemsbought', 'refills', 'nerverefills', 'tokenrefills'];
  // TornPDA replaces this placeholder with the user's key. The check below never
  // contains the literal placeholder text, so it survives PDA's replacement.
  const PDA_KEY = '###PDA-APIKEY###';

  // ===========================================================================
  // UTILITIES
  // ===========================================================================
  const U = {
    isNum(v) { return typeof v === 'number' && Number.isFinite(v); },
    clamp(v, lo, hi) { return Math.min(hi, Math.max(lo, v)); },
    pad2(n) { return (n < 10 ? '0' : '') + n; },
    esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));
    },
    int(n) {
      if (!U.isNum(n)) return '?';
      return Math.round(n).toLocaleString('en-US');
    },
    // 04:21:33 (or 1d 04:21:33)
    hms(ms) {
      if (!U.isNum(ms)) return '--:--:--';
      let s = Math.max(0, Math.ceil(ms / 1000));
      const d = Math.floor(s / 86400); s -= d * 86400;
      const h = Math.floor(s / 3600); s -= h * 3600;
      const m = Math.floor(s / 60); s -= m * 60;
      const core = U.pad2(h) + ':' + U.pad2(m) + ':' + U.pad2(s);
      return d > 0 ? d + 'd ' + core : core;
    },
    // 1d 06h / 2h 14m / 14m / 45s
    short(ms) {
      if (!U.isNum(ms)) return '?';
      let s = Math.max(0, Math.ceil(ms / 1000));
      const d = Math.floor(s / 86400); s -= d * 86400;
      const h = Math.floor(s / 3600); s -= h * 3600;
      const m = Math.floor(s / 60); s -= m * 60;
      if (d > 0) return d + 'd ' + U.pad2(h) + 'h';
      if (h > 0) return h + 'h ' + U.pad2(m) + 'm';
      if (m > 0) return m + 'm';
      return s + 's';
    },
    // 1d 06h 22m / 2h 14m / 14m 05s
    long(ms) {
      if (!U.isNum(ms)) return '?';
      let s = Math.max(0, Math.ceil(ms / 1000));
      const d = Math.floor(s / 86400); s -= d * 86400;
      const h = Math.floor(s / 3600); s -= h * 3600;
      const m = Math.floor(s / 60); s -= m * 60;
      if (d > 0) return d + 'd ' + U.pad2(h) + 'h ' + U.pad2(m) + 'm';
      if (h > 0) return h + 'h ' + U.pad2(m) + 'm';
      return m + 'm ' + U.pad2(s) + 's';
    },
    ago(ms) {
      if (!U.isNum(ms)) return 'never';
      const s = Math.max(0, Math.round(ms / 1000));
      if (s < 60) return s + 's ago';
      if (s < 3600) return Math.floor(s / 60) + 'm ago';
      if (s < 86400) return Math.floor(s / 3600) + 'h ago';
      return Math.floor(s / 86400) + 'd ago';
    },
    uid() { return Math.random().toString(36).slice(2, 10) + Date.now().toString(36).slice(-4); },
    deepMerge(base, over) {
      if (!over || typeof over !== 'object' || Array.isArray(over)) return base;
      const out = Array.isArray(base) ? base.slice() : Object.assign({}, base);
      for (const k of Object.keys(over)) {
        const bv = base ? base[k] : undefined;
        const ov = over[k];
        if (bv && typeof bv === 'object' && !Array.isArray(bv) && ov && typeof ov === 'object' && !Array.isArray(ov)) {
          out[k] = U.deepMerge(bv, ov);
        } else if (ov !== undefined) {
          out[k] = ov;
        }
      }
      return out;
    },
    clone(o) { return JSON.parse(JSON.stringify(o)); },
    // Removes the API key from any string before it can reach a log or the UI.
    redact(s) {
      return String(s == null ? '' : s).replace(/([?&]key=)[^&#\s]+/gi, '$1[redacted]').replace(/\b[A-Za-z0-9]{16}\b/g, (m) => (/\d/.test(m) && /[A-Za-z]/.test(m) ? '[redacted]' : m));
    },
    log(...args) {
      // Debug output is off by default; it never prints the key (args are redacted).
      if (!U.debug) return;
      try { console.log('[TRT]', ...args.map((a) => (typeof a === 'string' ? U.redact(a) : a))); } catch (e) { /* ignore */ }
    },
    debug: false,
  };

  const hasPdaKey = () => typeof PDA_KEY === 'string' && /^[A-Za-z0-9]{16}$/.test(PDA_KEY);

  // ===========================================================================
  // STORAGE  (userscript storage; falls back to localStorage with a trt: prefix)
  // ===========================================================================
  const Store = (() => {
    const PREFIX = 'trt:';
    const gm = (typeof GM_getValue === 'function' && typeof GM_setValue === 'function');
    const backend = gm ? 'userscript' : 'localStorage';
    function readRaw(k) {
      if (gm) return GM_getValue(PREFIX + k, undefined);
      return window.localStorage.getItem(PREFIX + k);
    }
    function get(k, def) {
      try {
        const raw = readRaw(k);
        if (raw === undefined || raw === null) return def;
        if (typeof raw !== 'string') return raw; // legacy structured values
        return JSON.parse(raw);
      } catch (e) { return def; }
    }
    function set(k, v) {
      try {
        const s = JSON.stringify(v);
        if (gm) GM_setValue(PREFIX + k, s); else window.localStorage.setItem(PREFIX + k, s);
        return true;
      } catch (e) { U.log('storage write failed', k); return false; }
    }
    function del(k) {
      try {
        if (gm && typeof GM_deleteValue === 'function') GM_deleteValue(PREFIX + k);
        else if (gm) GM_setValue(PREFIX + k, undefined);
        else window.localStorage.removeItem(PREFIX + k);
      } catch (e) { /* ignore */ }
    }
    return { get, set, del, backend };
  })();

  // ===========================================================================
  // SETTINGS
  // ===========================================================================
  const DEFAULT_SETTINGS = {
    v: 1,
    goals: { energy: 500, nerve: 100, xanax: 3, city: 100, casino: 75 }, // null = OFF
    energyFormat: 'goal', // 'goal' -> 650/500 when a goal is set, 'plain' -> 650 E
    compact: {
      energy: true, nerve: true, xanax: true, city: true, casino: true, oc: true,
      travel: false, drug: false, booster: false, medical: false, newDay: false,
    },
    modules: {
      energy: true, energyBreakdown: true, nerve: true, nerveBreakdown: true, xanax: true,
      city: true, casino: true, refills: true, drugCd: true, boosterCd: true, medicalCd: true,
      oc: true, travel: true, goalProgress: true, confidence: true, newDay: true, support: true,
    },
    ui: { state: 'collapsed', scale: 100, corner: 'top-right', pos: null },
    travel: { stayMinutes: 0, bufferMinutes: 15 },
    refresh: { coreSec: 60 },
    useLogs: true,
  };

  const Settings = (() => {
    let cur = load();
    const subs = [];
    function sanitizeGoal(v, max) {
      if (v === null || v === 'off' || v === '') return null;
      const n = Math.round(Number(v));
      if (!Number.isFinite(n) || n < 1) return null;
      return Math.min(n, max);
    }
    function sanitize(s) {
      const out = U.deepMerge(DEFAULT_SETTINGS, s || {});
      const g = out.goals;
      g.energy = sanitizeGoal(g.energy, 100000);
      g.nerve = sanitizeGoal(g.nerve, 100000);
      g.xanax = sanitizeGoal(g.xanax, 1000);
      g.city = sanitizeGoal(g.city, 100000);
      g.casino = sanitizeGoal(g.casino, 100000);
      if (!['goal', 'plain'].includes(out.energyFormat)) out.energyFormat = 'goal';
      if (!['collapsed', 'expanded', 'hidden'].includes(out.ui.state)) out.ui.state = 'collapsed';
      out.ui.scale = [80, 90, 100, 110, 120].includes(Number(out.ui.scale)) ? Number(out.ui.scale) : 100;
      if (!['top-left', 'top-right', 'bottom-left', 'bottom-right', 'custom'].includes(out.ui.corner)) out.ui.corner = 'top-right';
      const p = out.ui.pos;
      if (p && !(['left', 'right'].includes(p.h) && ['top', 'bottom'].includes(p.v) && U.isNum(p.x) && U.isNum(p.y))) out.ui.pos = null;
      if (out.ui.corner === 'custom' && !out.ui.pos) out.ui.corner = 'top-right';
      out.travel.stayMinutes = U.clamp(Math.round(Number(out.travel.stayMinutes) || 0), 0, 1440);
      out.travel.bufferMinutes = U.clamp(Math.round(Number(out.travel.bufferMinutes) || 0), 0, 720);
      out.refresh.coreSec = [30, 60, 120].includes(Number(out.refresh.coreSec)) ? Number(out.refresh.coreSec) : 60;
      out.useLogs = out.useLogs !== false;
      for (const k of Object.keys(out.compact)) out.compact[k] = !!out.compact[k];
      for (const k of Object.keys(out.modules)) out.modules[k] = !!out.modules[k];
      out.v = 1;
      return out;
    }
    function load() { return sanitize(Store.get('settings', null)); }
    function get() { return cur; }
    function update(mut, opts) {
      const next = U.clone(cur);
      mut(next);
      cur = sanitize(next);
      Store.set('settings', cur);
      if (!opts || !opts.silent) subs.forEach((f) => { try { f(cur); } catch (e) { U.log('settings sub', e); } });
      return cur;
    }
    function reload() { cur = load(); subs.forEach((f) => { try { f(cur); } catch (e) { /* ignore */ } }); }
    function reset() { cur = sanitize(null); Store.set('settings', cur); subs.forEach((f) => f(cur)); }
    function onChange(f) { subs.push(f); }
    return { get, update, reload, reset, onChange, sanitize };
  })();
  // ===========================================================================
  // TCT TIME ENGINE
  // Torn City Time is UTC. The engine derives "now" from Torn's server
  // timestamp (API 'timestamp' selection) and only falls back to the local
  // clock (read in UTC, never local time) until the first server sync.
  // ===========================================================================
  const Time = (() => {
    const samples = [];
    let offset = 0;            // serverMs - localMs
    let source = 'local-utc';  // 'torn-api' | 'torn-api-cached' | 'local-utc'
    let lastSyncAt = 0;
    let anchorDate = Date.now();
    let anchorPerf = perfNow();
    let jumpListeners = [];

    function perfNow() {
      return (typeof performance !== 'undefined' && typeof performance.now === 'function') ? performance.now() : Date.now();
    }
    function restore(meta) {
      const t = meta && meta.time;
      if (t && U.isNum(t.offset) && U.isNum(t.at) && Date.now() - t.at < DAY_MS && Math.abs(t.offset) < 7 * DAY_MS) {
        offset = t.offset; source = 'torn-api-cached'; lastSyncAt = t.at;
      }
    }
    // serverSec: Torn server unix time (seconds); sentAt/recvAt: local ms around the request
    function syncFromServer(serverSec, sentAt, recvAt) {
      if (!U.isNum(serverSec) || serverSec < 1.5e9) return false;
      const rtt = Math.max(0, recvAt - sentAt);
      if (rtt > 15000) return false;
      const est = serverSec * 1000 + 500 - (sentAt + rtt / 2); // server second is truncated -> +500ms
      samples.push(est);
      while (samples.length > 7) samples.shift();
      const sorted = samples.slice().sort((a, b) => a - b);
      offset = sorted[Math.floor(sorted.length / 2)];
      source = 'torn-api';
      lastSyncAt = recvAt;
      return true;
    }
    function now() { return Date.now() + offset; }
    function dayStart(ts) { return Math.floor(ts / DAY_MS) * DAY_MS; }
    function nextNewDay(ts) { return dayStart(ts) + DAY_MS; }
    function dateKey(ts) {
      const d = new Date(ts);
      return d.getUTCFullYear() + '-' + U.pad2(d.getUTCMonth() + 1) + '-' + U.pad2(d.getUTCDate());
    }
    function prevDateKey(key) { return dateKey(Date.parse(key + 'T00:00:00Z') - DAY_MS); }
    function currentDateKey() { return dateKey(now()); }
    function untilNewDay() { const n = now(); return nextNewDay(n) - n; }
    function dayFraction() { const n = now(); return (n - dayStart(n)) / DAY_MS; }
    // Detects local clock changes or system sleep: wall clock and monotonic clock disagree.
    function checkJump() {
      const d = Date.now(); const p = perfNow();
      const diff = (d - anchorDate) - (p - anchorPerf);
      anchorDate = d; anchorPerf = p;
      if (Math.abs(diff) > 3000) {
        if (source === 'torn-api') source = 'torn-api-cached';
        jumpListeners.forEach((f) => { try { f(diff); } catch (e) { /* ignore */ } });
        return true;
      }
      return false;
    }
    function onJump(f) { jumpListeners.push(f); }
    function info() { return { offset, source, lastSyncAt, samples: samples.length }; }
    // The ledger is only written once "now" comes from Torn (or Torn has
    // answered without a timestamp, in which case UTC is the documented fallback).
    function trusted() { return source !== 'local-utc'; }
    function acceptLocal() { if (source === 'local-utc') source = 'local-utc-fallback'; }
    function persistable() { return { offset, at: lastSyncAt }; }
    function fmtTct(ts) {
      const d = new Date(ts);
      return U.pad2(d.getUTCHours()) + ':' + U.pad2(d.getUTCMinutes()) + ':' + U.pad2(d.getUTCSeconds());
    }
    // Test hook: lets the test-suite inject a fake offset.
    function _setOffset(ms, src) { offset = ms; source = src || 'torn-api'; }
    return {
      restore, syncFromServer, now, dayStart, nextNewDay, dateKey, prevDateKey, currentDateKey,
      untilNewDay, dayFraction, checkJump, onJump, info, persistable, fmtTct, _setOffset, trusted, acceptLocal,
    };
  })();

  // ===========================================================================
  // MULTI-TAB SYNC
  // One tab (the leader) talks to the API; every tab renders from shared
  // storage. Leadership uses the Web Locks API when available, otherwise a
  // storage heartbeat. BroadcastChannel pushes "state changed" pings.
  // ===========================================================================
  const Sync = (() => {
    const tabId = U.uid();
    let leader = false;
    let mode = 'none';
    let heartbeatTimer = null;
    let bc = null;
    const leaderSubs = [];
    const msgSubs = [];
    let lastRev = null;

    try { if (typeof BroadcastChannel === 'function') bc = new BroadcastChannel('trt-sync-v1'); } catch (e) { bc = null; }
    if (bc) bc.onmessage = (ev) => { const m = ev && ev.data; if (m && m.from !== tabId) msgSubs.forEach((f) => f(m)); };

    function setLeader(v) {
      if (leader === v) return;
      leader = v;
      leaderSubs.forEach((f) => { try { f(v); } catch (e) { /* ignore */ } });
    }
    function requestLock(steal) {
      try {
        const opts = steal ? { mode: 'exclusive', steal: true } : { mode: 'exclusive' };
        navigator.locks.request('trt-leader-v1', opts, () => {
          setLeader(true);
          return new Promise(() => { /* held until the tab closes */ });
        }).catch(() => {
          // Lock was stolen by another tab or the request failed.
          setLeader(false);
          if (mode === 'locks') setTimeout(() => requestLock(false), 2000);
        });
      } catch (e) { startHeartbeat(); }
    }
    function startHeartbeat() {
      mode = 'heartbeat';
      const beat = () => {
        const now = Date.now();
        const L = Store.get('leader', null);
        if (!L || L.id === tabId || now - L.ts > 30000) {
          Store.set('leader', { id: tabId, ts: now });
          // write-then-verify to reduce double leadership
          setTimeout(() => { const C = Store.get('leader', null); setLeader(!!C && C.id === tabId); }, 250);
        } else {
          setLeader(false);
        }
      };
      beat();
      heartbeatTimer = setInterval(beat, 10000);
      window.addEventListener('pagehide', () => {
        const L = Store.get('leader', null);
        if (L && L.id === tabId) Store.del('leader');
      });
    }
    function start() {
      if (typeof navigator !== 'undefined' && navigator.locks && typeof navigator.locks.request === 'function') {
        mode = 'locks';
        requestLock(false);
      } else {
        startHeartbeat();
      }
      // Fallback change detection for environments without BroadcastChannel.
      setInterval(() => {
        const r = Store.get('rev', null);
        if (r && r.from !== tabId && (!lastRev || r.at !== lastRev.at)) {
          lastRev = r;
          if (!bc) msgSubs.forEach((f) => f(r));
        }
      }, 5000);
    }
    // A visible tab may take over when the leader stopped updating (e.g. a frozen tab).
    function takeOver() {
      if (leader) return;
      if (mode === 'locks') requestLock(true);
      else { Store.set('leader', { id: tabId, ts: Date.now() }); setLeader(true); }
    }
    function broadcast(type) {
      const msg = { type, from: tabId, at: Date.now() };
      lastRev = msg;
      Store.set('rev', msg);
      if (bc) { try { bc.postMessage(msg); } catch (e) { /* ignore */ } }
    }
    return {
      tabId, start, takeOver, broadcast,
      isLeader: () => leader,
      mode: () => mode,
      onLeader: (f) => leaderSubs.push(f),
      onMessage: (f) => msgSubs.push(f),
      _forceLeader: (v) => setLeader(v),
    };
  })();
  // ===========================================================================
  // API CLIENT
  // The only network code in the script. Every request goes to
  // https://api.torn.com/v2 and passes through one queue that enforces a
  // per-script budget, in-flight de-duplication, timeouts and backoff.
  // ===========================================================================
  const Api = (() => {
    const MAX_PER_MINUTE = 20;   // Torn allows 100/min per user across all tools; we use a fifth at most
    const TIMEOUT_MS = 15000;
    const stamps = [];           // send times inside the last minute
    const inflight = new Map();
    let pausedUntil = 0;
    let pauseReason = '';
    let halted = null;           // { code, message } when the key must not be used again
    const stats = { sent: 0, failed: 0, lastError: null, lastOkAt: 0 };
    const listeners = [];

    // Torn API error codes (https://www.torn.com/api.html)
    const HALT_CODES = { 1: 'API key is empty.', 2: 'Torn rejected the API key.', 10: 'The key owner is in federal jail.', 13: 'The key is disabled because the owner has been inactive for 7+ days.', 18: 'This API key is paused by its owner.' };
    const RETRY_CODES = new Set([0, 12, 15, 17]);

    function getKey() {
      const own = Store.get('apikey', null);
      if (typeof own === 'string' && /^[A-Za-z0-9]{16}$/.test(own)) return own;
      if (hasPdaKey()) return PDA_KEY;
      return null;
    }
    function keySource() {
      const own = Store.get('apikey', null);
      if (typeof own === 'string' && /^[A-Za-z0-9]{16}$/.test(own)) return 'saved';
      return hasPdaKey() ? 'tornpda' : null;
    }
    function keyFingerprint(k) {
      // short non-reversible tag so a stored "invalid key" flag only applies to that key
      let h = 2166136261;
      for (let i = 0; i < k.length; i++) { h ^= k.charCodeAt(i); h = Math.imul(h, 16777619); }
      return (h >>> 0).toString(36);
    }
    function emit() { listeners.forEach((f) => { try { f(); } catch (e) { /* ignore */ } }); }
    function qs(params) {
      return Object.keys(params)
        .filter((k) => params[k] !== undefined && params[k] !== null && params[k] !== '')
        .map((k) => encodeURIComponent(k) + '=' + encodeURIComponent(Array.isArray(params[k]) ? params[k].join(',') : String(params[k])))
        .join('&');
    }
    function sleep(ms) { return new Promise((r) => setTimeout(r, ms)); }
    async function waitForSlot() {
      for (;;) {
        const now = Date.now();
        if (pausedUntil > now) { await sleep(Math.min(pausedUntil - now, 5000)); continue; }
        while (stamps.length && now - stamps[0] > 60000) stamps.shift();
        if (stamps.length < MAX_PER_MINUTE) { stamps.push(now); return; }
        await sleep(Math.max(250, 60000 - (now - stamps[0]) + 50));
      }
    }
    function restoreHalt() {
      const k = getKey();
      const flag = Store.get('keyflag', null);
      if (k && flag && flag.fp === keyFingerprint(k)) halted = { code: flag.code, message: flag.message };
      else halted = null;
    }
    function clearHalt() { halted = null; Store.del('keyflag'); emit(); }
    function pause(ms, reason) { pausedUntil = Math.max(pausedUntil, Date.now() + ms); pauseReason = reason; emit(); }

    async function doFetch(url) {
      const ctrl = typeof AbortController === 'function' ? new AbortController() : null;
      const timer = setTimeout(() => { if (ctrl) ctrl.abort(); }, TIMEOUT_MS);
      try {
        const res = await fetch(url, { method: 'GET', credentials: 'omit', cache: 'no-store', signal: ctrl ? ctrl.signal : undefined, headers: { Accept: 'application/json' } });
        const text = await res.text();
        let json = null;
        try { json = JSON.parse(text); } catch (e) { return { netError: 'Torn returned an unreadable response (HTTP ' + res.status + ').' }; }
        return { json };
      } catch (e) {
        return { netError: (e && e.name === 'AbortError') ? 'Request timed out.' : 'Network error.' };
      } finally { clearTimeout(timer); }
    }

    // path: '/user', '/user/log', ...; params: query params (no key). Returns
    // { ok:true, data, sentAt, recvAt } or { ok:false, error:{ code, message } }
    function request(path, params, opts) {
      const o = opts || {};
      const dedupKey = path + '?' + qs(params || {});
      if (inflight.has(dedupKey)) return inflight.get(dedupKey);
      const p = (async () => {
        let attempt = 0;
        for (;;) {
