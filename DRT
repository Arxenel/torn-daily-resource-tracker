    }

    function needsHistBaseline(day) {
      const flags = Data.meta.flags || {};
      for (const st of COUNTER_STATS) {
        const m = Ledger.counterMetric(day, st, flags);
        const c = day.counters[st];
        if (m.state === 'ok' && m.conf !== Ledger.CONF.V && c && !c.hist && (c.histTries || 0) < 3 && Date.now() - (c.histTried || 0) > 10 * 60000) return true;
