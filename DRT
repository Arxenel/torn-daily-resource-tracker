      vm.nerve = logSection('N', S.goals.nerve, 'nerve');

      // --- Counters (Xanax, City)
      const counterSection = (stat, kind, goal) => {
        if (!access) return { state: ks.state === 'none' ? 'nokey' : 'loading', goal: goalInfo(null, goal) };
        if (!access.sel.includes('personalstats')) return { state: 'needs', need: 'personalstats', goal: goalInfo(null, goal) };
        if (!day || Data.ephemeral) return { state: 'loading', goal: goalInfo(null, goal) };
        const m = Ledger.refined(day, stat, kind, flags, logsUsable);
        if (m.state !== 'ok') return { state: meta.countersError ? 'error' : 'loading', error: meta.countersError, goal: goalInfo(null, goal) };
        const d = counterDisplay(m);
